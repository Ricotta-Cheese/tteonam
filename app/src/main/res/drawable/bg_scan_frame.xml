<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 좌상 -->
    <item android:gravity="top|start" android:width="32dp" android:height="4dp">
        <shape><solid android:color="#FFFFFF" /><corners android:radius="2dp" /></shape>
    </item>
    <item android:gravity="top|start" android:width="4dp" android:height="32dp">
        <shape><solid android:color="#FFFFFF" /><corners android:radius="2dp" /></shape>
    </item>
    <!-- 우상 -->
    <item android:gravity="top|end" android:width="32dp" android:height="4dp">
        <shape><solid android:color="#FFFFFF" /><corners android:radius="2dp" /></shape>
    </item>
    <item android:gravity="top|end" android:width="4dp" android:height="32dp">
        <shape><solid android:color="#FFFFFF" /><corners android:radius="2dp" /></shape>
    </item>
    <!-- 좌하 -->
    <item android:gravity="bottom|start" android:width="32dp" android:height="4dp">
        <shape><solid android:color="#FFFFFF" /><corners android:radius="2dp" /></shape>
    </item>
    <item android:gravity="bottom|start" android:width="4dp" android:height="32dp">
        <shape><solid android:color="#FFFFFF" /><corners android:radius="2dp" /></shape>
    </item>
    <!-- 우하 -->
    <item android:gravity="bottom|end" android:width="32dp" android:height="4dp">
        <shape><solid android:color="#FFFFFF" /><corners android:radius="2dp" /></shape>
    </item>
    <item android:gravity="bottom|end" android:width="4dp" android:height="32dp">
        <shape><solid android:color="#FFFFFF" /><corners android:radius="2dp" /></shape>
    </item>
</layer-list>