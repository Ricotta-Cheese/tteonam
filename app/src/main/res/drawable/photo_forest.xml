<?xml version="1.0" encoding="utf-8"?>
<!-- 로그인 콜라주: 가운데 숲 사진 카드 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape><solid android:color="@color/white" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:left="5dp" android:right="5dp" android:top="5dp" android:bottom="5dp">
        <shape>
            <gradient android:angle="300" android:startColor="@color/photo_forest_light" android:endColor="@color/photo_forest_dark" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
