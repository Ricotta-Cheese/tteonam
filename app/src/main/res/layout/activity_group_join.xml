<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EFE8"
    android:orientation="vertical">

    <!-- 상단바 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로가기"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#333333"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="그룹 참여"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- QR 스캔 영역: 남는 높이를 모두 차지 -->
    <FrameLayout
        android:id="@+id/scanArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_camera"
        android:clipToOutline="true">

        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_scan_frame" />

        <View
            android:id="@+id/scanLine"
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:background="#E8806A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:text="친구 화면의 초대 QR을 비춰 주세요"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- 구분선 + 또는 초대 코드 입력 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#E0D6CB" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="또는 초대 코드 입력"
            android:textColor="#9A8F85"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#E0D6CB" />
    </LinearLayout>

    <!-- 6자리 코드 입력 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etCode1"
            style="@style/CodeBox" />

        <EditText
            android:id="@+id/etCode2"
            style="@style/CodeBox" />

        <EditText
            android:id="@+id/etCode3"
            style="@style/CodeBox" />

        <EditText
            android:id="@+id/etCode4"
            style="@style/CodeBox" />

        <EditText
            android:id="@+id/etCode5"
            style="@style/CodeBox" />

        <EditText
            android:id="@+id/etCode6"
            style="@style/CodeBox"
            android:layout_marginEnd="0dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:text="6자리 코드는 그룹 관리 화면에서 확인할 수 있어요"
        android:textColor="#9A8F85"
        android:textSize="10sp" />

    <!-- 하단 버튼 -->
    <Button
        android:id="@+id/btnJoin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_button_join"
        android:enabled="false"
        android:stateListAnimator="@null"
        android:text="그룹 참여하기"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>