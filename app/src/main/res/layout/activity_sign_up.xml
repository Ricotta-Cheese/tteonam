<?xml version="1.0" encoding="utf-8"?>
<!--
    02 회원가입 화면 (기획서 8쪽 시안).
    위쪽 바(뒤로 가기 + 제목)는 고정하고, 아래 입력 영역만 스크롤한다.
    입력칸 이름은 칸 위의 라벨로 보여 주고, 안내·오류는 칸 아래에 바로 표시한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SignUpActivity">

    <!-- 위쪽 바 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/Widget.Tteonam.IconButton"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/title_sign_up"
            android:textAppearance="@style/TextAppearance.Tteonam.Title" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:text="@string/sign_up_headline"
                android:textAppearance="@style/TextAppearance.Tteonam.Display"
                android:textSize="22sp" />

            <!-- 닉네임 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:labelFor="@id/nickname_input"
                android:text="@string/hint_nickname"
                android:textAppearance="@style/TextAppearance.Tteonam.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nickname_layout"
                style="@style/Widget.Tteonam.TextInput.NoHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:counterEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nickname_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="nickname"
                    android:hint="@string/placeholder_nickname"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 이메일: 중복 여부는 가입 버튼을 누를 때 확인한다 (사전 중복 확인 버튼 없음) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:labelFor="@id/email_input"
                android:text="@string/hint_email"
                android:textAppearance="@style/TextAppearance.Tteonam.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/email_layout"
                style="@style/Widget.Tteonam.TextInput.NoHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:helperText="@string/sign_up_email_helper"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/email_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:hint="@string/placeholder_email"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 비밀번호: 칸 아래에 규칙 충족 여부(✓/✗)를 바로 표시 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:labelFor="@id/password_input"
                android:text="@string/hint_password"
                android:textAppearance="@style/TextAppearance.Tteonam.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/password_layout"
                style="@style/Widget.Tteonam.TextInput.NoHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/password_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:hint="@string/placeholder_password"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 비밀번호 확인 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:labelFor="@id/confirm_input"
                android:text="@string/hint_password_confirm"
                android:textAppearance="@style/TextAppearance.Tteonam.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/confirm_layout"
                style="@style/Widget.Tteonam.TextInput.NoHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/confirm_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:hint="@string/placeholder_password_confirm"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 약관 동의 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <CheckBox
                    android:id="@+id/terms_all_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/terms_all"
                    android:textColor="@color/tn_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginVertical="2dp"
                    android:background="@color/tn_divider" />

                <CheckBox
                    android:id="@+id/terms_service_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/terms_service"
                    android:textColor="@color/tn_text_secondary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/terms_privacy_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/terms_privacy"
                    android:textColor="@color/tn_text_secondary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/terms_location_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/terms_location"
                    android:textColor="@color/tn_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/form_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.Tteonam.Body"
                android:textColor="@color/tn_error"
                android:visibility="gone"
                tools:text="이미 가입된 이메일이에요."
                tools:visibility="visible" />

            <!-- 모든 조건을 채워야 활성화된다 -->
            <Button
                android:id="@+id/sign_up_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:enabled="false"
                android:text="@string/action_sign_up" />

            <!-- 계정은 만들어졌지만 닉네임 저장이 실패했을 때만 보인다 -->
            <Button
                android:id="@+id/retry_profile_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/action_retry_profile"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/sign_up_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/tn_primary"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
